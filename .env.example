# Project ID: https://manage.sanity.io > project > Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Create a dedicated PRIVATE dataset named registrations in project > Datasets.
NEXT_PUBLIC_SANITY_DATASET=registrations
# Fixed API version date.
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-07
# Project > API > Tokens: Editor, or restricted registration/authRateLimit read/create/update role.
# Must be able to inspect dataset visibility; never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REGISTRATION_FORM_SECRET=

# Admin: server-only. npm run hash-password prints an escaped .env.local hash.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Exact website origin; use your HTTPS domain in production.
NEXTAUTH_URL=http://127.0.0.1:3000
